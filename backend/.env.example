# Conexión al PostgreSQL del servidor del profesor
DATABASE_URL=postgresql+psycopg://usuario:password@host_servidor_profesor:5432/nombre_bd

# Entorno y autenticación provisional de Fase 0 (CT-02)
ENVIRONMENT=development
DEV_USER_1_ID=00000000-0000-0000-0000-000000000001
DEV_USER_2_ID=00000000-0000-0000-0000-000000000002
ALLOW_DEV_USER_HEADER=true

# CORS para el arnés HTML en desarrollo y VM
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080"]
