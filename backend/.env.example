# Copiar a .env y ajustar. Nunca subir el .env real al repositorio.
# Local (docker compose): usuario/clave/BD definidos en docker-compose.yml.
# VM: reemplazar por la URL entregada por el profesor SOLO en el .env de la VM.
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/asesor_financiero_db

# Base de datos para pytest (opcional). Si no se define se usa DATABASE_URL;
# las pruebas corren dentro de una transacción que se revierte al terminar.
# TEST_DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/asesor_financiero_test

# Orígenes permitidos por CORS, separados por coma (incluir el host del frontend).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Walking Skeleton: usa el cliente demo si no llega la cabecera X-User-Id.
DEMO_MODE=true
