# Copiar este archivo como .env y completar los valores reales.
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).

# Conexión a la base de datos del team-5 en el servidor del curso (obligatoria para arrancar el backend).
# Formato: postgresql+psycopg://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
DATABASE_URL=postgresql+psycopg://g1_team_5_user:CAMBIAR_CONTRASENA@34.69.97.140:5432/g1-team-5-db

# Para desarrollo local con la base de datos de prueba (perfil local-db):
# DATABASE_URL=postgresql+psycopg://app:app@localhost:5433/asesor_financiero_local

# Puerto publicado en la VM (libre y abierto en el firewall).
FRONTEND_PORT=3005

# Frontend: modo real HTTP por defecto ("false"). Solo usa datos simulados si VITE_USE_MOCK_API=true.
VITE_USE_MOCK_API=false
