{
  "$schema": "./contract.schema.json",
  "id": "startSurvey",
  "pythonName": "start_survey",
  "module": "survey",
  "owner": "SurveyManager",
  "kind": "service",
  "source": {
    "document": "docs/design/02_Interaction_and_Data_Design.md",
    "section": "§3.2 (contrato) y §2.4 (concurrencia); diagrama §1.1",
    "documentVersion": "v1.2 (PR #13)"
  },
  "traceability": [
    "REQ-01 Flujo principal pasos 1-2",
    "REQ-01 Escenario 2 (único DRAFT)",
    "BR-02"
  ],
  "purpose": "Iniciar la encuesta de onboarding del cliente autenticado en estado DRAFT, o devolver el borrador existente, junto con el catálogo activo de preguntas.",
  "input": [
    {
      "name": "userId",
      "pythonName": "user_id",
      "type": "UUID",
      "constraints": "No nulo. Corresponde a CLIENT.client_id.",
      "source": "Contexto de autenticación: Depends(get_current_user). Nunca del body HTTP."
    }
  ],
  "output": {
    "type": "Survey",
    "description": "Survey en DRAFT con questions cargadas.",
    "fields": [
      {
        "name": "surveyId",
        "type": "UUID"
      },
      {
        "name": "clientId",
        "type": "UUID",
        "note": "Diseño 01 §3.2 lo llama userId en la clase Survey; ver document_corrections.json (DC-04)."
      },
      {
        "name": "status",
        "type": "SurveyStatus",
        "allowedValues": [
          "DRAFT",
          "COMPLETED"
        ]
      },
      {
        "name": "startedAt",
        "type": "datetime (ISO 8601 con zona)"
      },
      {
        "name": "questions",
        "type": "Question[]",
        "note": "Catálogo activo ordenado por displayOrder; máximo 10 (BR-02)."
      }
    ],
    "questionShape": "Question { questionId: int, text: string, weight: Decimal (string en JSON), displayOrder: int, isRequired: bool }"
  },
  "preconditions": [
    "userId autenticado."
  ],
  "postconditions": [
    "Existe exactamente un DRAFT para userId (idempotente: si ya existía, se devuelve el existente).",
    "Si no existía, se crea con started_at = now()."
  ],
  "failureOutcomes": [
    {
      "error": "UnauthorizedError",
      "condition": "El token/identidad no es válido.",
      "httpStatus": 401,
      "resultingState": "Sin cambios."
    }
  ],
  "invariants": [
    "A lo sumo un DRAFT por client_id.",
    "No modifica respuestas ni encuestas COMPLETED."
  ],
  "concurrency": {
    "strategy": "Insertar el DRAFT dentro de una transacción, respaldado por el índice único parcial (client_id) WHERE status = 'DRAFT'. Ante conflicto de unicidad, consultar y devolver el borrador que ganó la carrera.",
    "expectedBehavior": "Dos peticiones simultáneas no crean dos borradores; ambas obtienen el mismo DRAFT."
  },
  "collaborators": [
    "SurveyRepository.findDraftByUserId",
    "SurveyRepository.save (implementado como create_draft, ver DC-05)"
  ],
  "dataConstraints": [
    {
      "rule": "Un DRAFT por cliente",
      "enforcement": "ix_survey_one_draft_per_client (único parcial)",
      "implemented": true
    },
    {
      "rule": "BR-02 máx. 10 preguntas activas",
      "enforcement": "trg_question_max_active + LIMIT 10 en get_active_questions",
      "implemented": true
    }
  ],
  "testableExamples": [
    {
      "case": "Cliente sin borrador",
      "before": "Cliente C1 registrado, sin DRAFT; 3 preguntas activas.",
      "request": "startSurvey(C1)",
      "expected": "Nuevo Survey DRAFT de C1 con 3 preguntas ordenadas.",
      "origin": "derivado de §3.2"
    },
    {
      "case": "Cliente con borrador (idempotencia)",
      "before": "C1 tiene DRAFT S1.",
      "request": "startSurvey(C1)",
      "expected": "Devuelve S1; no crea otro.",
      "origin": "derivado de §3.2"
    },
    {
      "case": "Carrera de creación",
      "before": "Otra petición creó S1 tras la consulta.",
      "request": "startSurvey(C1)",
      "expected": "Devuelve S1 (el ganador).",
      "origin": "§2.4"
    },
    {
      "case": "Identidad inválida",
      "before": "Cualquiera",
      "request": "startSurvey con userId inválido o inexistente",
      "expected": "401; sin cambios.",
      "origin": "§3.2"
    }
  ],
  "httpBinding": {
    "status": "IMPLEMENTED",
    "method": "POST",
    "path": "/api/v1/surveys/start",
    "request": "Sin body. Cabecera X-User-Id (Walking Skeleton).",
    "responses": {
      "200": "SurveyStartResponse",
      "401": "Identidad inválida o cliente inexistente"
    }
  },
  "implementation": {
    "status": "IMPLEMENTED",
    "plannedSlice": "Fase 0 (Walking Skeleton)",
    "branch": "feat/walking-skeleton-db",
    "code": [
      "backend/src/survey/router.py: start_survey",
      "backend/src/survey/service.py: SurveyManager.start_survey",
      "backend/src/survey/repository.py: find_draft_by_user_id, create_draft, get_active_questions",
      "backend/src/core/auth_deps.py: get_current_user"
    ],
    "tests": [
      "test_start_survey_when_registered_client_then_returns_draft_and_questions",
      "test_start_survey_when_draft_exists_then_returns_same_draft",
      "test_create_draft_when_draft_already_exists_then_returns_existing",
      "test_start_survey_when_client_not_registered_then_returns_401",
      "test_start_survey_when_user_id_header_invalid_then_returns_401"
    ]
  },
  "openQuestions": [],
  "relatedCorrections": [
    "DC-04",
    "DC-05"
  ]
}
