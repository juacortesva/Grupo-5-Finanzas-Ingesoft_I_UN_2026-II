# URL base del backend FastAPI para desarrollo local sin proxy y generación de tipos OpenAPI.
# En producción con Docker/Nginx (y con vite proxy local), dejar vacío para usar rutas relativas (/api/...).
VITE_API_URL=

# Activa el adaptador simulado únicamente si es "true". Por defecto ("false") usa el backend HTTP real.
VITE_USE_MOCK_API=false

# Token provisional de Fase 0 (CT-02 / ADR-0006). Si no se define, usa "dev-user-1" salvo VITE_ENABLE_DEV_AUTH=false.
VITE_DEV_AUTH_TOKEN=dev-user-1
VITE_ENABLE_DEV_AUTH=true
